# Optional environment overrides.
TERRASATCH_EDGE_API_URL=https://api.terrasatch.com
TERRASATCH_EDGE_API_KEY=
TERRASATCH_EDGE_SITE_ID=
TERRASATCH_EDGE_SCAN_INTERVAL_SECONDS=30

# v0.2.3 receive-only BCA/FRS pilot.
TERRASATCH_EDGE_RADIO_PROFILE=bca-frs-na
TERRASATCH_EDGE_RADIO_CHANNEL=
TERRASATCH_EDGE_RADIO_OUTPUT_SAMPLE_RATE=16000
TERRASATCH_EDGE_RADIO_DEMOD_SAMPLE_RATE=24000
TERRASATCH_EDGE_RADIO_SQUELCH=20
TERRASATCH_EDGE_RADIO_SQUELCH_DELAY=10
TERRASATCH_EDGE_RADIO_GAIN_DB=
TERRASATCH_EDGE_RADIO_CHUNK_SECONDS=0.20
TERRASATCH_EDGE_RADIO_SILENCE_SECONDS=0.90
TERRASATCH_EDGE_RADIO_MIN_SECONDS=0.40
TERRASATCH_EDGE_RADIO_MAX_SECONDS=30.0
